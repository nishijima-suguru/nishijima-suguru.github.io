{% if site.enable_google_verification or site.enable_bing_verification %}
  <!-- Website verification -->
  {% if site.enable_google_verification %}
    <meta name="google-site-verification" content="{{ site.google_site_verification }}">
  {% endif %}
  {% if site.enable_bing_verification %}
    <meta name="msvalidate.01" content="{{ site.bing_site_verification }}">
  {% endif %}
  <!--
    Avoid warning on Google Chrome Error with Permissions-Policy header:
    Origin trial controlled feature not enabled: 'interest-cohort'.
    see https://stackoverflow.com/a/75119417
  -->
  <meta http-equiv="Permissions-Policy" content="interest-cohort=()">
{% endif %}

{% capture author_name %}{% include display_name.liquid %}{% endcapture %}

<!-- Standard metadata -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
{% if site.title == 'blank' %}
  {% capture title %}{{ author_name }}{% endcapture %}
{% else %}
  {% capture title %}{{ site.title }}{% endcapture %}
{% endif %}
{% if page.title != null and page.title != '' %}
  {% if page.url == '/blog/index.html' %}
    {% capture page_title %}{{ site.data[site.active_lang].strings.blog.navigation_title }}{% endcapture %}
  {% else %}
    {% assign page_title = page.title %}
  {% endif %}
{% else %}
  {% assign page_title = null %}
{% endif %}
{% if page_title %}
  {% assign title_array = '' | split: ',' %}
  {% assign splitted_description_by_space = page_title | split: ' ' %}
  {% for outer_part in splitted_description_by_space %}
    {% if outer_part contains '.' %}
      {% capture contains_localization %}{% localization_exists {{ outer_part }} %}{% endcapture %}
      {% if contains_localization == 'true' %}
        {% assign first_part = outer_part | split: '.' | first %}
        {% assign last_part = outer_part | split: '.' | last %}
        {% capture temp_var %}{{ site.data[site.active_lang].strings[first_part][last_part] }}{% endcapture %}
        {% assign title_array = title_array | push: temp_var %}
      {% else %}
        {% capture temp_var %}{{ outer_part }}{% endcapture %}
        {% assign title_array = title_array | push: temp_var %}
      {% endif %}
    {% else %}
      {% capture temp_var %}{{ outer_part }}{% endcapture %}
      {% assign title_array = title_array | push: temp_var %}
    {% endif %}
  {% endfor %}
  {% assign page_title = title_array | join: ' ' %}
{% endif %}
{% if page.description %}
  {% assign description = page.description %}
{% else %}
  {% assign description = site.data[site.active_lang].strings.site_description %}
{% endif %}
<title>
  {% if page.url == '/blog/index.html' %}
    {{ page.title }} | {{ title }}
  {% elsif page.url contains '/blog/' %}
    {% capture blog_year %}{{ page.url | slice: 0, 11 }}{% endcapture %}
    {% if page.url == blog_year %}
      {{ page.date | date: '%Y' }} | {{ title }}
    {% else %}
      {{ page_title }} | {{ title }}
    {% endif %}
  {% elsif page.title != 'blank' and page.url != '/' %}
    {% if page.title == null or page.title == '' %}
      {{ page.date | date: '%Y' }} | {{ title }}
    {% else %}
      {{ page_title }} | {{ title }}
    {% endif %}
  {% else %}
    {{ title }}
  {% endif %}
</title>
<meta name="author" content="{{ author_name }}">
<meta name="description" content="{{ description }}">
{% if page.keywords or site.keywords %}
  <meta name="keywords" content="{% if page.keywords %}{{ page.keywords }}{% else %}{{ site.keywords }}{% endif %}">
{% endif %}

{% assign is_blog_post = false %}
{% if page.url != '/blog/index.html' and page.url contains '/blog/' %}
  {% unless page.url contains '/tag/' or page.url contains '/category/' %}
    {% assign is_blog_post = true %}
  {% endunless %}
{% endif %}

{% if site.serve_og_meta %}
  {%- comment -%}
    og:image must be an absolute URL — X, Bluesky, Slack and friends will not
    resolve a relative one, so a bare filename means no preview image at all.
    A plain file name is treated as living in /assets/img/; anything containing
    '://' or starting with '/' is passed through as given.
  {%- endcomment -%}
  {% assign og_image_raw = page.og_image | default: site.og_image %}
  {% if og_image_raw contains '://' %}
    {% assign og_image_url = og_image_raw %}
  {% elsif og_image_raw %}
    {% assign og_image_path = og_image_raw %}
    {% unless og_image_raw contains '/' %}
      {% assign og_image_path = og_image_raw | prepend: '/assets/img/' %}
    {% endunless %}
    {% assign og_image_url = og_image_path | absolute_url %}
  {% endif %}
  <!-- OpenGraph -->
  <meta property="og:site_name" content="{{ title }}">
  <meta property="og:type" content="{% if is_blog_post %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{% if page.title %}{{ title }} | {{ page_title }}{% else %}{{ title }}{% endif %}">
  <meta property="og:url" content="{{ page.url | prepend: site.baseurl | prepend: site.url | remove_first: 'index.html' }}">
  <meta property="og:description" content="{{ description }}">
  {% if og_image_url %}
    <meta property="og:image" content="{{ og_image_url }}">
  {% endif %}
  <meta property="og:locale" content="{{ site.active_lang }}">

  <!-- Twitter card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{% if page.title %}{{ page_title }}{% else %}{{ title }}{% endif %}">
  <meta name="twitter:description" content="{{ description }}">
  {% if og_image_url %}
    <meta name="twitter:image" content="{{ og_image_url }}">
  {% endif %}
  {% if site.x_username %}
    <meta name="twitter:site" content="@{{ site.x_username }}">
    <meta name="twitter:creator" content="@{{ site.x_username }}">
  {% endif %}
{% endif %}

{% if site.serve_schema_org %}
  <!-- Schema.org -->
  {%- comment -%}
    sameAs links for schema.org.

    This block used to read site.orcid_id, site.scholar_userid and friends, but
    the theme keeps those in _data/socials.yml — so every lookup was nil and
    "sameAs" never made it into the JSON-LD. Reading from site.data.socials is
    what actually populates it, and driving it from a table beats the 40-branch
    if-chain that was here.
  {%- endcomment -%}
  {% assign sameaslinks = '' | split: ',' %}
  {% assign socials = site.data.socials %}
  {% assign social_map = 'orcid_id|https://orcid.org/,scholar_userid|https://scholar.google.com/citations?user=,semanticscholar_id|https://www.semanticscholar.org/author/,github_username|https://github.com/,gitlab_username|https://gitlab.com/,linkedin_username|https://www.linkedin.com/in/,x_username|https://x.com/,bluesky_url|,mastodon_username|https://,research_gate_profile|https://www.researchgate.net/profile/,scopus_id|https://www.scopus.com/authid/detail.uri?authorId=,osf_id|https://osf.io/,dblp_url|,work_url|,wikidata_id|https://www.wikidata.org/wiki/,youtube_id|https://youtube.com/@,zotero_username|https://www.zotero.org/' | split: ',' %}
  {% for pair in social_map %}
    {% assign key = pair | split: '|' | first %}
    {% assign prefix = pair | split: '|' | last %}
    {% assign value = socials[key] %}
    {% if value and value != blank %}
      {% if prefix == key %}
        {% assign prefix = '' %}
      {% endif %}
      {% capture link %}{{ prefix }}{{ value }}{% endcapture %}
      {% assign sameaslinks = sameaslinks | push: link %}
    {% endif %}
  {% endfor %}
  {% if sameaslinks != blank %}
    {% assign sameaslinks = sameaslinks | jsonify %}
  {% endif %}

  <script type="application/ld+json">
    {
        "author":
        {
            "@type": "Person",
            "name": "{{ author_name }}"
        },
        "url": "{{ page.url | prepend: site.baseurl | prepend: site.url }}",
        "@type": "{% if is_blog_post %}BlogPosting{% else %}WebSite{% endif %}",
        "description": "{{ description }}",
        "headline": "{% if page.title %}{{ page_title }}{% else %}{{ site.title }}{% endif %}",
        {% if sameaslinks != blank %}
        "sameAs": {{ sameaslinks }},
        {% endif %}
        "name": "{{ author_name }}",
        "@context": "https://schema.org"
    }
  </script>
{% endif %}
